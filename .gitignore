# ============================================================
# Git ignore — Medical RAG projekat
# ============================================================

# --- Podaci i medicinski materijal (ne objavljivati) ---
data/
pdfs/
*.pdf
*.PDF

# --- Generisani indeksi i keš ---
*.pkl
*.pickle
*.index
faiss.index
chunks.pkl
*.npy
*.npz
*.bin

# --- Modeli i kvantizacije ---
*.gguf
*.safetensors
*.ckpt
models/
lmstudio/

# --- Virtuelno okruženje ---
venv/
.venv/
env/
ENV/
virtualenv/

# --- Python keš i build artefakti ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Testiranje i pokrivenost ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Notebook keš ---
.ipynb_checkpoints/

# --- IDE i editori ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS fajlovi ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# --- Tajne i konfiguracija ---
.env
.env.*
!.env.example
secrets/
*.key
*.pem

# --- Logovi ---
*.log
logs/

# --- Privremeni fajlovi ---
*.tmp
*.temp
tmp/
temp/

# --- Streamlit (ako kasnije dodamo) ---
.streamlit/secrets.toml

# --- Izlazi eksperimenata ---
outputs/
runs/
wandb/
mlruns/