# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# === Virtualno okruzenje ===
venv/
.venv/
env/
ENV/

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === OS ===
.DS_Store
Thumbs.db

# === Podaci (veliki fajlovi) ===
# PDF-ovi — mogu biti veliki, ne commit-ujemo
pdfs/*.pdf

# Ekstrahovani tekst — moze biti velik, generisemo ga ponovo
data/extracted/*.jsonl

# Structure — generisemo ga ponovo
data/structure/*.json
data/structure/*.toc.json

# Chunkovi — generisemo ih ponovo
data/chunks/*.jsonl

# FAISS indeks — velik, generisemo ga ponovo
data/index/*.index
data/index/*.jsonl

# === Logovi i temp ===
*.log
/tmp/
.cache/

# === Model kes ===
# Ako koristis HuggingFace, keš je van projekta (u ~/.cache/),
# ali za svaki slucaj:
.cache/